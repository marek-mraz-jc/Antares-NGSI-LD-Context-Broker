// routes-without-decision: an HTTP route whose handler reaches no policy decision (T-3569); public routes are allowlisted with their reason
MATCH (h:Symbol)-[:PROVIDES]->(c:Channel {channel:'http'}) WHERE NOT h.is_test AND NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..6]->(g:Symbol) WHERE g.path IN ['antares_api::policy::gate','antares_api::policy::gate_each','antares_api::policy::decide','antares_api::policy::decide_each'] } RETURN c.key, h.path ORDER BY c.key;
// surface-calls-the-store: a surface symbol touching a store or SQL symbol, or the store fields of AppState's Shared, past antares-ops (threat model 9.4 M2, F1)
MATCH (s:Symbol)-[:CALLS|REFERENCES]->(t:Symbol) WHERE NOT s.is_test AND s.package =~ 'antares-(views|odata|mcp|linkml|ws|icsr)' AND (t.package IN ['antares-store','antares-sql'] OR t.path IN ['antares_api::state::Shared::store','antares_api::state::Shared::temporal']) RETURN DISTINCT s.path, t.path ORDER BY s.path;
// protocol-crate-depends-on-antares: a protocol crate depending on an antares-* crate (threat model 9.4 M1)
MATCH (a:Package)-[d:DEPENDS_ON]->(b:Package) WHERE (a.name STARTS WITH 'odata-' OR a.name = 'linkml-model') AND b.name STARTS WITH 'antares-' RETURN a.name, b.name, d.kind;
// identity-headers: the Tenant header named outside the code that owns it (threat F2)
GREP (?i)"(x-)?ngsild-tenant" IN crates/*/src/**/*.rs;
// sql-from-text: dynamic SQL (sqlx takes a non-literal statement only through AssertSqlSafe); every function that builds one names why its interpolations are not input
MATCH (c:Symbol)-[:CALLS|REFERENCES]->(x:Symbol) WHERE x.name = 'AssertSqlSafe' AND x.external AND NOT c.is_test RETURN DISTINCT c.path ORDER BY c.path;
// egress-outside-policy: a reqwest client built anywhere but antares_jsonld::client_builder, which applies the EgressPolicy (SSRF)
MATCH (c:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path STARTS WITH 'reqwest::' AND x.name IN ['builder','new','default'] AND (x.path CONTAINS '::Client::' OR x.path CONTAINS '::ClientBuilder::') AND NOT c.is_test AND NOT c.file CONTAINS '/examples/' AND c.path <> 'antares_jsonld::loader::client_builder' RETURN DISTINCT c.path, x.path ORDER BY c.path;
// surface-entry-without-ops: a surface entry (the handler a surface router names) that reaches no antares-ops operation; with surface-calls-the-store this proves a surface runs through ViewOps/Ops, whose AppState::call lands in the gated NGSI-LD handlers (T-3844)
MATCH (s:Symbol) WHERE NOT s.is_test AND s.kind = 'Function' AND s.package =~ 'antares-(views|odata|mcp|linkml|ws|icsr)' AND s.name IN ['serve','upgrade','get_one','put_one','delete_one'] AND NOT EXISTS { MATCH (s)-[:CALLS|DISPATCHES*1..8]->(o:Symbol) WHERE o.path STARTS WITH 'antares_ops::' AND o.kind IN ['Method','Function'] } RETURN s.path ORDER BY s.path;
// fs-from-a-request: a filesystem call reachable from an HTTP route handler or a surface entry; a request never names a path the broker opens (T-3844)
MATCH (h:Symbol) WHERE NOT h.is_test AND (EXISTS { MATCH (h)-[:PROVIDES]->(:Channel {channel:'http'}) } OR (h.kind = 'Function' AND h.package =~ 'antares-(views|odata|mcp|linkml|ws|icsr)' AND h.name IN ['serve','upgrade','get_one','put_one','delete_one'])) MATCH (h)-[:CALLS|DISPATCHES*0..8]->(k:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND (x.path STARTS WITH 'std::fs::' OR x.path STARTS WITH 'tokio::fs::') AND NOT k.is_test RETURN DISTINCT h.path, k.path ORDER BY h.path;
// process-spawn: a child process started by shipped code (build scripts and tests aside) (T-3844)
MATCH (c:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path =~ '(std|tokio)::process::Command::new' AND NOT c.is_test AND NOT c.file ENDS WITH 'build.rs' RETURN DISTINCT c.path ORDER BY c.path;
// untrusted-format-parser: a YAML or binary serde format in shipped code; request bodies are JSON (serde under the body limit) and nothing else (T-3844)
MATCH (c:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path =~ '(serde_yaml|serde_yml|serde_norway|bincode|rmp_serde|ciborium|postcard|serde_cbor|serde_pickle)::.*' AND NOT c.is_test RETURN DISTINCT c.path, x.path ORDER BY c.path;

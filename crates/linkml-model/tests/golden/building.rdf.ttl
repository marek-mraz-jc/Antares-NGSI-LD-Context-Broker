# RDF Schema, rendered from the LinkML model.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/building#Asset> a rdfs:Class ;
  rdfs:label "Asset" .

<https://schema.org/Room> a rdfs:Class ;
  rdfs:label "Room" ;
  rdfs:subClassOf <https://example.org/building#Asset> .

<https://example.org/building#Sensor> a rdfs:Class ;
  rdfs:label "Sensor" ;
  rdfs:subClassOf <https://example.org/building#Asset> .

<https://example.org/building#floor> a rdf:Property ;
  rdfs:label "floor" ;
  rdfs:range xsd:integer .

<https://example.org/building#location> a rdf:Property ;
  rdfs:label "location" ;
  rdfs:range <https://schema.org/Room> .

<https://schema.org/name> a rdf:Property ;
  rdfs:label "name" ;
  rdfs:range xsd:string .

<https://example.org/building#sensors> a rdf:Property ;
  rdfs:label "sensors" ;
  rdfs:range <https://example.org/building#Sensor> .

<https://example.org/building#status> a rdf:Property ;
  rdfs:label "status" ;
  rdfs:range xsd:string .

<https://example.org/building#temperature> a rdf:Property ;
  rdfs:label "temperature" ;
  rdfs:range xsd:float .

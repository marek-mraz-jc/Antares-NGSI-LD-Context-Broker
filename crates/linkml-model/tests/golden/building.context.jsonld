    },
    "name": "https://schema.org/name",
    "sensors": {
      "@id": "https://example.org/building#sensors",
      "@type": "@id"
    },
    "status": "https://example.org/building#status",
    "temperature": {
      "@id": "https://example.org/building#temperature",
      "@type": "http://www.w3.org/2001/XMLSchema#float"
    }
  }
}
